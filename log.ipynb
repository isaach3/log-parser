# %%
excel_writer = pd.ExcelWriter('output.xlsx', engine='xlsxwriter')
csv_files = glob.glob("parsed*.csv")
# Read each CSV file and write to separate Excel tabs
for csv_filename in csv_files:
    df = pd.read_csv(csv_filename)
    sheet_name = csv_filename[7:-4]  # Extract sheet name from filename (excluding ".csv")
    df.to_excel(excel_writer, sheet_name=sheet_name, index=False)

# Save the Excel file
excel_writer.save()

