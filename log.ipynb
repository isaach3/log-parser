def mark_bots(df,bot_ips):
    df['Device'] = np.where(df['Content Type'] == 'robots.txt', 'bot', df['Device'])
    df.apply(lambda row: 'bot' if row['IP'] in bot_ips else row['Device'], axis=1)


# %%

csv_files = glob.glob("*.csv")
# Preallocate the size of the combined DataFrame
combined_data = pd.DataFrame(columns=['IP', 'Timestamp', 'Method', 'Path', 'URL', 'Category', 'Content Type', 'Status', 'Bytes', 'Referer', 'User Agent', 'Device'])
# Iterate through CSV files and append DataFrames to a list
dfs = []
for csv_file in csv_files:
    df = pd.read_csv(csv_file)
    dfs.append(df)
# Concatenate all DataFrames in the list
combined_data = pd.concat(dfs, ignore_index=True)
# Save the combined data to a CSV file
combined_data.to_csv("combined.csv", index=False, encoding='utf-8-sig')



# %%
combined_data.head()

# %%
unique_timestamps = combined_data.groupby('IP')['Timestamp'].nunique()
total_entries = combined_data.groupby('IP').size()
bot_ips = total_entries[total_entries > unique_timestamps].index

# %%
csv_files = glob.glob("*.csv")
for csv_file in csv_files:
    df = pd.read_csv(csv_file)
    df['Device'] = np.where(df['Content Type'] == 'robots.txt', 'bot', df['Device'])
    df.apply(lambda row: 'bot' if row['IP'] in bot_ips else row['Device'], axis=1)
    df.to_csv(f"parsed_{csv_file[11:]}.csv", index=False, encoding='utf-8-sig')

